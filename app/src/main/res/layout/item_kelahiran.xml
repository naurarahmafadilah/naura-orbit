<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EAEFF5"
    android:backgroundTint="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:backgroundTint="#E6F4EA">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="#137333"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvNamaBayi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Nama Bayi"
                android:textColor="#137333"
                android:fontFamily="@font/poppins_bold"
                android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/layoutHeader"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvJenisKelamin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laki-laki"
                android:fontFamily="@font/poppins_medium"
                android:textSize="11sp"
                android:textColor="#137333"
                android:background="#E6F4EA"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tvTanggalLahir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-07-06"
                android:fontFamily="@font/poppins_medium"
                android:textSize="11sp"
                android:textColor="#2F5DA9"
                android:background="#EAF2FF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/layoutBadges">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Nama Ayah"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="12sp"
                    android:textColor="#8A9AA8"/>
                <TextView
                    android:id="@+id/tvNamaAyah"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Ayah"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:gravity="end"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Nama Ibu"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="12sp"
                    android:textColor="#8A9AA8"/>
                <TextView
                    android:id="@+id/tvNamaIbu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Ibu"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:gravity="end"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Berat Lahir"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="12sp"
                    android:textColor="#8A9AA8"/>
                <TextView
                    android:id="@+id/tvBeratLahir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="3.2 Kg"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:gravity="end"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Panjang Lahir"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="12sp"
                    android:textColor="#8A9AA8"/>
                <TextView
                    android:id="@+id/tvPanjangLahir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="50 Cm"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:gravity="end"/>
            </RelativeLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailKelahiran"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_below="@id/layoutDetail"
            android:layout_alignParentEnd="true"
            android:text="Lihat Detail"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_medium"
            app:cornerRadius="10dp"
            android:backgroundTint="#137333"
            app:icon="@android:drawable/ic_menu_view"
            app:iconSize="14dp"
            app:iconPadding="6dp"/>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
