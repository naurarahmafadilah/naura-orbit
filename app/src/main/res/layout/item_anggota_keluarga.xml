<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EAEFF5"
    android:backgroundTint="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutHeaderKeluarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:backgroundTint="#EAF2FF">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#2F5DA9"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvItemKepalaKeluarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Nama Kepala Keluarga"
                android:textColor="#1F3E73"
                android:fontFamily="@font/poppins_bold"
                android:textSize="15sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBadgesKeluarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/layoutHeaderKeluarga"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvItemJumlahAnggota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Anggota"
                android:fontFamily="@font/poppins_medium"
                android:textSize="11sp"
                android:textColor="#2F5DA9"
                android:background="#EAF2FF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keluarga"
                android:fontFamily="@font/poppins_medium"
                android:textSize="11sp"
                android:textColor="#4CAF50"
                android:background="#E8F5E9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDetailKeluarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_below="@id/layoutBadgesKeluarga">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="No. KK"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="12sp"
                    android:textColor="#8A9AA8"/>

                <TextView
                    android:id="@+id/tvItemNoKK"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="KK: 3522XXXXXXXXXXXX"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:gravity="end"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Alamat"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="12sp"
                    android:textColor="#8A9AA8"/>

                <TextView
                    android:id="@+id/tvItemAlamatKeluarga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Jl. Nusa Indah No. 00"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:gravity="end"/>
            </RelativeLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailKeluarga"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_below="@id/layoutDetailKeluarga"
            android:layout_alignParentEnd="true"
            android:text="Lihat KK"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_medium"
            app:cornerRadius="10dp"
            android:backgroundTint="#2F5DA9"
            app:icon="@android:drawable/ic_menu_view"
            app:iconSize="14dp"
            app:iconPadding="6dp"/>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>