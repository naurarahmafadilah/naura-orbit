<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ringkasan Data &amp; Statistik Warga"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1F3E73"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analisis karakteristik dan persebaran individu warga secara real-time."
            android:fontFamily="@font/poppins_regular"
            android:textColor="#7F8C8D"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:layout_marginTop="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:backgroundTint="@color/white"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rata-rata Usia"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#7F8C8D"
                        android:textSize="11sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="32.4"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#2F5DA9"
                        android:textSize="22sp"
                        android:layout_marginTop="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tahun / Warga"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="#9EAAB6"
                        android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:backgroundTint="@color/white"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Angkatan Kerja"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#7F8C8D"
                        android:textSize="11sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="74%"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="#2E7D32"
                        android:textSize="22sp"
                        android:layout_marginTop="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bekerja &amp; Wirausaha"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="#9EAAB6"
                        android:textSize="10sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sebaran Populasi Wilayah (Jiwa)"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#1F3E73"
                    android:textSize="14sp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:id="@+id/tvDusunWarga1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dusun Krajan (RT 01 - RT 05)"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#2C3E50"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvCountDusunWarga1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="580 Jiwa"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#2F5DA9"
                        android:textSize="12sp"/>
                </RelativeLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:progress="65"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:trackColor="#F0F7FF"
                    app:indicatorColor="#2F5DA9"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dusun Kaliurang (RT 06 - RT 10)"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#2C3E50"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="392 Jiwa"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#2F5DA9"
                        android:textSize="12sp"/>
                </RelativeLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:progress="45"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:trackColor="#FDF2E9"
                    app:indicatorColor="#E67E22"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dusun Karanglo (RT 11 - RT 14)"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#2C3E50"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="273 Jiwa"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#2F5DA9"
                        android:textSize="12sp"/>
                </RelativeLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:progress="28"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:trackColor="#F5EEF8"
                    app:indicatorColor="#9B59B6"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="* Data individual disinkronkan otomatis berdasarkan sistem pencatatan sipil."
            android:fontFamily="@font/poppins_regular"
            android:textColor="#9EAAB6"
            android:textSize="10sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>