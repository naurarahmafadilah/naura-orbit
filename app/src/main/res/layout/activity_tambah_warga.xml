<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/toolbarTambahWarga"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#2F5DA9"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackTambah"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/btnBackTambah"
            android:fontFamily="@font/poppins_semibold"
            android:text="Tambah Warga"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Pendaftaran Warga Baru"
                android:textColor="#1A2E56"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Pastikan data kependudukan diisi secara sah dan benar."
                android:textColor="#8A9AA8"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:backgroundTint="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Nomor Induk Kependudukan (NIK)"
                        app:boxStrokeColor="#2F5DA9"
                        app:hintTextColor="#2F5DA9">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputNik"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="number"
                            android:maxLength="16"
                            android:textColor="#1A2E56"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:hint="Nama Lengkap Warga"
                        app:boxStrokeColor="#2F5DA9"
                        app:hintTextColor="#2F5DA9">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputNamaWarga"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textCapWords"
                            android:textColor="#1A2E56"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Wilayah Tempat Tinggal (RT/RW)"
                        app:boxStrokeColor="#2F5DA9"
                        app:hintTextColor="#2F5DA9"
                        app:placeholderText="Contoh: RT 03 / RW 05">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputWilayah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="text"
                            android:textColor="#1A2E56"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                android:backgroundTint="#F8FAFC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@android:drawable/ic_popup_reminder"
                            app:tint="#2F5DA9" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Pengingat Validasi Berkas Lapangan"
                            android:textColor="#1A2E56"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Atur waktu penundaan alarm otomatis untuk melakukan verifikasi berkas fisik warga ke lokasi tujuan."
                        android:textColor="#7F8C8D"
                        android:textSize="11sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingatkan saya dalam"
                        app:boxStrokeColor="#2F5DA9"
                        app:hintTextColor="#2F5DA9"
                        app:suffixText="Menit"
                        app:suffixTextColor="#2F5DA9">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputMenitReminder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:inputType="number"
                            android:text="10"
                            android:textColor="#1A2E56"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpanWarga"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#2F5DA9"
                android:fontFamily="@font/poppins_semibold"
                android:text="Daftarkan Warga &amp; Jadwalkan"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:elevation="3dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>