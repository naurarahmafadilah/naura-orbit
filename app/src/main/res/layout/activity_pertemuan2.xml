<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2FF"
    android:padding="24dp"
    tools:context="pertemuan_2.pertemuan_2">

    <!-- Card Container -->

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Judul -->

            <TextView
                android:id="@+id/judul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kalkulator Bangun"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#333333"
                android:layout_marginBottom="24dp"/>

            <!-- Input Alas -->

            <EditText
                android:id="@+id/inputAlas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan Alas Segitiga"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginBottom="12dp"/>

            <!-- Input Tinggi -->

            <EditText
                android:id="@+id/inputTinggi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan Tinggi Segitiga"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- Button Segitiga -->

            <Button
                android:id="@+id/btnSegitiga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hitung Luas Segitiga"
                android:backgroundTint="#6366F1"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <!-- Input Sisi -->

            <EditText
                android:id="@+id/inputSisi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan Sisi Kubus"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:layout_marginBottom="16dp"/>

            <!-- Button Kubus -->

            <Button
                android:id="@+id/btnKubus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hitung Volume Kubus"
                android:backgroundTint="#06B6D4"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <!-- Hasil -->

            <TextView
                android:id="@+id/tvHasil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hasil:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#16A34A"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>