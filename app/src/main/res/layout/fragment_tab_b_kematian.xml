<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Layanan Penerbitan Akta Kematian"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1F3E73"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panduan pelaporan dan penerbitan dokumen Akta Kematian."
            android:fontFamily="@font/poppins_regular"
            android:textColor="#7F8C8D"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Persyaratan Berkas"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#1F3E73"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Surat Keterangan Kematian dari dokter/rumah sakit/desa.\n2. Kartu Keluarga (KK) asli warga yang wafat.\n3. KTP-el asli warga yang wafat.\n4. Fotokopi KTP pelapor (ahli waris).\n5. Fotokopi KTP saksi (2 orang)."
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#455A64"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prosedur Alur Pelayanan"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#1F3E73"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#EA4335"
                        android:text="1"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="12sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Meminta Surat Keterangan Desa"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2C3E50"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ajukan permohonan surat kematian ke ketua RT/RW untuk disahkan di Balai Desa."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="#FCE8E6"
                    android:layout_marginStart="13dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#EA4335"
                        android:text="2"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="12sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verifikasi dan Entri Data"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2C3E50"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Petugas desa akan memverifikasi berkas dan menonaktifkan data penduduk bersangkutan di KK."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="#FCE8E6"
                    android:layout_marginStart="13dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#2E7D32"
                        android:text="✓"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="14sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pencetakan Akta Kematian"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Penerbitan akta kematian resmi bersamaan dengan KK baru milik keluarga korban."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
