<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark"
    tools:context=".Home.pertemuan_6.SatuFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_black"
            android:text="NusaData"
            android:textColor="@color/white"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Dashboard Utama"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:alpha="0.8" />

        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:background="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Selamat datang di sistem kependudukan digital. Silakan gunakan menu navigasi untuk mengelola data warga, administrasi keluarga, dan mutasi domisili secara real-time."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</FrameLayout>