<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF">

    <!-- Top Premium Dark Blue Banner (Sama dengan Profile) -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_header_curved"
            app:layout_scrollFlags="scroll|enterAlways">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="38dp"
                android:text="Tentang Nusa Data"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold" />

        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-40dp"
        android:background="@drawable/bg_rounded_canvas"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Card Foto Desa (Keren & Premium) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EAEFF5"
                android:backgroundTint="@color/white">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/desa" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:src="@drawable/logo_nusadata" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Nusa Data"
                        android:textColor="#1F3E73"
                        android:textSize="22sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Bina Desa Digital"
                        android:textColor="#2F5DA9"
                        android:textSize="12sp"
                        android:layout_marginTop="-4dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingExtra="7dp"
                android:text="Nusa Data merupakan program pengembangan masyarakat yang berfokus pada peningkatan kesejahteraan warga desa melalui edukasi, inovasi, dan kolaborasi antara pemerintah, masyarakat, serta mahasiswa. Program ini menjadi wujud nyata kontribusi akademik terhadap pembangunan berkelanjutan di tingkat desa."
                android:textColor="#455A64"
                android:textSize="14sp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginVertical="28dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Tujuan Utama Program"
                android:textColor="#1F3E73"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ Meningkatkan kapasitas masyarakat dalam mengelola potensi lokal." android:fontFamily="@font/poppins_medium" android:textColor="#2F5DA9" android:paddingBottom="8dp" android:textSize="13sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ Menumbuhkan semangat inovasi dan kemandirian di desa." android:fontFamily="@font/poppins_medium" android:textColor="#2F5DA9" android:paddingBottom="8dp" android:textSize="13sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ Menjalin kemitraan antara mahasiswa, masyarakat, dan pemerintah." android:fontFamily="@font/poppins_medium" android:textColor="#2F5DA9" android:paddingBottom="8dp" android:textSize="13sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ Mendorong terciptanya lingkungan desa yang berdaya dan berkelanjutan." android:fontFamily="@font/poppins_medium" android:textColor="#2F5DA9" android:textSize="13sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginVertical="28dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Modul Kegiatan"
                android:textColor="#1F3E73"
                android:textSize="18sp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="top">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📝" android:textSize="22sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modul Edukasi" android:fontFamily="@font/poppins_bold" android:textColor="#455A64" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Memberikan pelatihan kepada masyarakat agar mampu mandiri dalam mengelola potensi lokal secara berkelanjutan." android:fontFamily="@font/poppins_regular" android:textColor="#78909C" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="top">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="22sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modul Inovasi" android:fontFamily="@font/poppins_bold" android:textColor="#455A64" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Memperkenalkan teknologi baru untuk meningkatkan produktivitas masyarakat dan efisiensi pembangunan desa." android:fontFamily="@font/poppins_regular" android:textColor="#78909C" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="top">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤝" android:textSize="22sp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modul Kolaborasi" android:fontFamily="@font/poppins_bold" android:textColor="#455A64" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mendorong kerja sama aktif antara warga, mahasiswa, dan pemerintah untuk menciptakan desa yang tangguh." android:fontFamily="@font/poppins_regular" android:textColor="#78909C" android:textSize="12sp" android:lineSpacingExtra="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Membangun Desa, Membangun Bangsa"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#2F5DA9"
                    android:textSize="11sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="© 2026 NusaData Indonesia • v2.0.4"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#BDBDBD"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>