<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Layanan Penerbitan Akta Kelahiran"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1F3E73"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panduan pencatatan kelahiran baru untuk memperoleh NIK dan Akta."
            android:fontFamily="@font/poppins_regular"
            android:textColor="#7F8C8D"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Persyaratan Dokumen"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#1F3E73"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Surat Keterangan Kelahiran dari Bidan/Rumah Sakit.\n2. Fotokopi Buku Nikah / Akta Perkawinan Orang Tua.\n3. Kartu Keluarga (KK) Asli Orang Tua.\n4. KTP Asli &amp; Fotokopi kedua orang tua.\n5. KTP Sakit (2 orang saksi kelahiran)."
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#455A64"
                    android:textSize="12sp"
                    android:lineSpacingExtra="4dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alur Prosedur Pelayanan"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#1F3E73"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#137333"
                        android:text="1"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="12sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pelaporan ke RT/RW &amp; Dusun"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2C3E50"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Laporkan kelahiran baru ke ketua RT/RW setempat untuk mendapatkan surat pengantar."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="#E6F4EA"
                    android:layout_marginStart="13dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#137333"
                        android:text="2"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="12sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pengajuan di Kantor Balai Desa"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2C3E50"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Serahkan seluruh berkas persyaratan ke loket pelayanan kependudukan di Balai Desa NusaData."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="#E6F4EA"
                    android:layout_marginStart="13dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#2E7D32"
                        android:text="✓"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="14sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Penerbitan KK Baru &amp; Akta"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sistem akan mencetak kartu keluarga terbaru beserta Akta Kelahiran resmi anak."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
