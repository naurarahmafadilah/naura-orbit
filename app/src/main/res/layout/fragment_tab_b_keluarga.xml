<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panduan &amp; Layanan Warga"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1F3E73"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alur penerbitan dokumen kependudukan mandiri (KTP/KIA)."
            android:fontFamily="@font/poppins_regular"
            android:textColor="#7F8C8D"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alur Penerbitan KTP-el / KIA Warga"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#1F3E73"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#2F5DA9"
                        android:text="1"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="12sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pencatatan Kartu Keluarga (KK)"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2C3E50"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pastikan nama individu warga bersangkutan sudah tercantum aktif di dalam sistem KK nasional."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="#D1E4FF"
                    android:layout_marginStart="13dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#2F5DA9"
                        android:text="2"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="12sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Perekaman Biometrik di Kecamatan"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2C3E50"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bawa fotokopi KK ke unit pelayanan Disdukcapil/Kecamatan untuk pengambilan foto, retina, dan sidik jari."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="2dp"
                    android:layout_height="16dp"
                    android:background="#D1E4FF"
                    android:layout_marginStart="13dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#2E7D32"
                        android:text="✓"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="14sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pengambilan Fisik Kartu"
                            android:fontFamily="@font/poppins_medium"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KTP-el / KIA dapat diambil langsung di loket Balai Desa setelah status pencetakan pusat selesai."
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#7F8C8D"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Petugas Registrasi Warga"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1F3E73"
            android:textSize="14sp"
            android:layout_marginTop="22dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:layout_marginTop="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:backgroundTint="@color/white"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bpk. Rian H."
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#2C3E50"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin Biodata Individu"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="#7F8C8D"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hubungi"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#2F5DA9"
                        android:textSize="11sp"
                        android:layout_marginTop="10dp"
                        android:background="#F0F7FF"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:backgroundTint="@color/white"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ibu Sarah"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#2C3E50"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pelayanan KTP &amp; KIA"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="#7F8C8D"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hubungi"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#E67E22"
                        android:textSize="11sp"
                        android:layout_marginTop="10dp"
                        android:background="#FDF2E9"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jam Operasional Pelayanan Balai Desa:\nSenin - Jumat | 08.00 - 15.00 WIB"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#9EAAB6"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>