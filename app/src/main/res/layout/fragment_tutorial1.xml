<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F2B5C"
    android:padding="32dp">

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="-60dp"
        android:layout_marginStart="-60dp"
        android:background="@android:drawable/ic_menu_compass"
        android:backgroundTint="#2F76E2"
        android:alpha="0.06" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="44dp"
            android:background="@android:drawable/toast_frame"
            android:backgroundTint="#1AFFFFFF">

            <ImageView
                android:id="@+id/imgTutorial1"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="Ilustrasi Data"
                app:tint="#FFFFFF"
                android:alpha="0.95" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selamat Datang di NusaData"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/tvDesc1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginHorizontal="20dp"
            android:text="Sistem informasi kependudukan digital yang memudahkan pengelolaan data warga secara cepat, aman, dan akurat."
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:alpha="0.85"
            android:lineSpacingMultiplier="1.35" />
    </LinearLayout>

</RelativeLayout>