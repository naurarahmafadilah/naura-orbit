<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F9FC"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Statistik Mutasi Penduduk"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1F3E73"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analisis pergerakan masuk dan keluar warga di NusaData."
            android:fontFamily="@font/poppins_regular"
            android:textColor="#7F8C8D"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:backgroundTint="@color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rasio Pindah Masuk vs Keluar"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#1F3E73"
                    android:textSize="14sp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pindah Masuk"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#2C3E50"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="10 Orang (55.6%)"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"/>
                </RelativeLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:progress="56"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:trackColor="#E8F5E9"
                    app:indicatorColor="#2E7D32"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pindah Keluar"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="#2C3E50"
                        android:textSize="12sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="8 Orang (44.4%)"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="#EA4335"
                        android:textSize="12sp"/>
                </RelativeLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:progress="44"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:trackColor="#FCE8E6"
                    app:indicatorColor="#EA4335"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
